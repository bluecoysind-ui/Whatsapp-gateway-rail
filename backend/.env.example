PORT=3000
NODE_ENV=development

DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=securepassword123
API_KEY=your_api_key_here
# Proxy check target for POST /proxy/test
PROXY_CHECK_URL=https://api.ipify.org?format=json

# ---------------------------------------------------------------------------
# Default outbound proxy (applied to every session that has no explicit proxy)
# ---------------------------------------------------------------------------
# Option A: a single full URL (wins over the components below).
#   Supported schemes: http, https, socks5, socks4
#   PROXY_URL=http://sp35wslyfg:ZXyna0dCujR~t9v3j8@dc.decodo.com:10001
#
# Option B: individual components (credentials are URL-encoded automatically,
# so passwords with special characters are safe here). Example: Decodo.
PROXY_PROTOCOL=http
PROXY_HOST=dc.decodo.com
PROXY_PORT=10001
PROXY_USERNAME=sp35wslyfg
PROXY_PASSWORD=ZXyna0dCujR~t9v3j8

# ---- Proxy pool & rotation (optional) ----
# Give the gateway several egress IPs to spread accounts across and to rotate to
# when WhatsApp rate-limits an IP. Any of these three build the pool:
#   PROXY_URLS  — explicit list of full proxy URLs (comma/space/newline separated)
#     PROXY_URLS=http://u:p@host:10001, http://u:p@host:10002
#   PROXY_PORTS — expand the components above across many ports (list and/or range).
#     Decodo exposes one rotating IP per port, so a range gives you a ready pool:
PROXY_PORTS=10001-10010
# PROXY_COOLDOWN_MS — how long a proxy is skipped after it gets rate-limited (default 60000).
PROXY_COOLDOWN_MS=60000
# PROXY_REQUIRED — when true (the default whenever any proxy is configured), an
# account NEVER connects directly: if no proxy is usable it retries instead.
# Set to false only if you explicitly want to allow direct fallback.
PROXY_REQUIRED=true

# Media limits
UPLOAD_MAX_BYTES=67108864
MEDIA_AUTOSAVE_MAX_BYTES=26214400

# ---------------------------------------------------------------------------
# Bluecoys pairing callbacks
# ---------------------------------------------------------------------------
# Fired as POST {phone_number, username, name} after a QR scan links an account.
# Query string also includes phone_number. Set to empty to disable.
WHATSAPP_LINKED_CALLBACK_URL=https://bluecoys.com/api/whatsapp-linked
# Fired as GET ?phone_number=... when a previously connected account drops.
WHATSAPP_DISCONNECTED_CALLBACK_URL=https://bluecoys.com/api/whatsapp-disconnected
# How long an unscanned QR stays valid (ms). Default 120000 (2 minutes).
# QR_EXPIRY_MS=120000
